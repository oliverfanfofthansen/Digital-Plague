.world-root { flex-grow: 1; background-color: #08131b; color: #d4e1e5; font-size: 14px; }
Label { margin: 0; padding: 0; }
Button { border-radius: 0; border-width: 1px; border-color: #30474e; background-color: #101f28; color: #bacdd2; padding: 8px 14px; margin: 0; font-size: 12px; letter-spacing: 1px; }
Button:hover { background-color: #203740; border-color: #6bafb6; color: #effaff; }
Button:focus { border-color: #d2aa68; }
Button:disabled { opacity: .35; }
.primary { background-color: #21464b; border-color: #579b9f; color: #e0f8f5; }
.primary:hover { background-color: #305c60; border-color: #9cd1cc; }
.eyebrow { font-size: 10px; letter-spacing: 1.4px; color: #79939d; }
.cyan { color: #6fc4c7; }
.amber { color: #d4a365; }
.muted { color: #78939d; font-size: 12px; }
.small-copy { color: #8098a2; font-size: 12px; white-space: normal; margin-top: 12px; }
.main-menu { flex-grow: 1; background-color: #08131b; }
.menu-map-host { position: absolute; left: 0; top: 0; right: 0; bottom: 0; opacity: .65; }
.menu-shade { position: absolute; left: 0; top: 0; width: 610px; bottom: 0; background-color: rgba(8, 19, 27, .94); border-right-width: 1px; border-right-color: #1f343d; }
.menu-topline { position: absolute; top: 34px; left: 56px; font-size: 11px; letter-spacing: 2px; color: #7e9aa5; }
.menu-content { position: absolute; left: 76px; top: 20%; width: 428px; }
.menu-title { font-size: 78px; letter-spacing: 6px; -unity-font-style: bold; margin-top: 18px; color: #d8e5e6; }
.menu-tagline { font-size: 11px; letter-spacing: 2px; color: #85b8bd; margin-top: 20px; }
.menu-description { white-space: normal; color: #839ba6; font-size: 14px; margin-top: 18px; margin-bottom: 32px; }
.menu-button { height: 48px; width: 330px; margin-bottom: 10px; -unity-text-align: middle-left; padding-left: 18px; }
.menu-button.quiet { background-color: transparent; border-color: transparent; color: #77919d; }
.menu-button.quiet:hover { color: #d4a365; border-color: #715936; }
.menu-bottomline { position: absolute; left: 76px; bottom: 55px; font-size: 9px; letter-spacing: 1px; color: #637d88; }
.menu-credit { position: absolute; right: 28px; bottom: 24px; font-size: 9px; letter-spacing: 1px; color: #526e79; }
.game-screen { flex-grow: 1; display: none; }
.top-bar { height: 66px; flex-shrink: 0; flex-direction: row; align-items: center; background-color: #0b171f; border-bottom-width: 1px; border-bottom-color: #2a4049; padding-left: 24px; padding-right: 20px; }
.game-brand { width: 245px; font-size: 15px; -unity-font-style: bold; letter-spacing: 1px; color: #d0e0e2; }
.resource { border-left-width: 1px; border-left-color: #2a4049; padding-left: 22px; margin-right: 24px; }
.resource-value { font-size: 17px; margin-top: 5px; }
.top-spacer, .bottom-spacer { flex-grow: 1; }
.top-button { padding: 7px 10px; margin-left: 8px; font-size: 10px; border-color: #273d47; background-color: transparent; }
.game-body { flex-direction: row; flex-grow: 1; min-height: 0; }
.map-column { flex-grow: 1; min-width: 0; background-color: #07141c; overflow: hidden; }
.map-host, .world-map { flex-grow: 1; overflow: hidden; }
.map-heading { position: absolute; left: 25px; top: 22px; }
.map-phase { font-size: 12px; letter-spacing: 2px; color: #c4d8dc; }
.map-instruction { font-size: 11px; color: #6b8b96; margin-top: 7px; }
.map-legend { position: absolute; left: 25px; bottom: 20px; flex-direction: row; }
.map-legend Label { font-size: 10px; margin-right: 24px; letter-spacing: 1px; }
.map-tools { position: absolute; right: 22px; bottom: 15px; flex-direction: row; }
.map-tools Button { min-width: 34px; height: 30px; padding: 4px 9px; margin-left: 5px; font-size: 12px; }
.map-marker { position: absolute; width: 18px; height: 18px; min-width: 0; padding: 0; border-radius: 9px; border-width: 1px; border-color: #7eaeb6; background-color: #122934; overflow: visible; }
.map-marker:hover { background-color: #598f95; border-color: #d2f9f2; }
.map-marker.influenced { background-color: #5ba9ae; border-color: #9ddcda; }
.map-marker.selected { border-color: #ecc584; border-width: 2px; }
.map-marker.origin { background-color: #c69556; }
.marker-name { position: absolute; left: 25px; top: 2px; font-size: 10px; letter-spacing: .8px; color: #96b1b9; white-space: nowrap; }
.map-marker.selected .marker-name { color: #e4bf84; }
.map-marker.influenced .marker-name { color: #abd6d8; }
.location-panel { width: 300px; flex-shrink: 0; border-left-width: 1px; border-left-color: #2a4049; background-color: #0c1921; }
.location-scroll { flex-grow: 1; padding: 24px 20px 16px 20px; }
.location-title { font-size: 27px; -unity-font-style: bold; color: #d8e6e7; white-space: normal; margin-top: 12px; margin-bottom: 8px; }
.coordinates { font-size: 10px; color: #64838f; letter-spacing: 1px; }
.divider { height: 1px; background-color: #263d47; margin-top: 21px; margin-bottom: 18px; }
.stat-row { flex-direction: row; justify-content: space-between; margin-top: 17px; font-size: 12px; color: #99aeb6; }
.stat-value { color: #cddde1; }
.stat-value.cyan { color: #6fc4c7; }
.stat-value.amber { color: #d4a365; }
.meter { height: 3px; background-color: #1a313c; margin-top: 8px; }
.meter-fill { width: 0; height: 3px; background-color: #579a9e; }
.amber-fill { background-color: #ae8754; }
.influence-value { font-size: 32px; margin-top: 9px; margin-bottom: 6px; }
.connected-locations { flex-direction: row; flex-wrap: wrap; margin-top: 10px; }
.connected-locations Button { font-size: 10px; padding: 5px 7px; margin-right: 6px; margin-bottom: 6px; letter-spacing: 0; }
.selection-status { font-size: 11px; white-space: normal; margin-top: 17px; margin-bottom: 11px; }
.start-button { height: 44px; margin-top: 3px; }
.feed-heading { margin-top: 26px; margin-bottom: 10px; }
.network-feed { font-size: 11px; white-space: normal; color: #6f939e; }
.bottom-bar { height: 54px; flex-shrink: 0; flex-direction: row; align-items: center; padding: 0 22px; background-color: #0b171f; border-top-width: 1px; border-top-color: #2a4049; }
.input-hint { font-size: 9px; letter-spacing: .8px; color: #617f8c; width: 310px; }
.speed-controls { flex-direction: row; }
.speed-controls Button { height: 32px; min-width: 46px; margin-right: 6px; padding: 4px 10px; }
.speed-controls Button.is-selected { background-color: #2c5559; border-color: #70b9ba; color: #d6f7f3; }
.speed-label { font-size: 10px; letter-spacing: 1px; margin-left: 13px; }
.elapsed-label { font-size: 15px; letter-spacing: 1px; color: #b4c9cf; }
.settings-overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(1, 8, 13, .88); align-items: center; justify-content: center; display: none; }
.settings-panel { width: 480px; padding: 32px; background-color: #0e1d27; border-width: 1px; border-color: #3c5e67; }
.settings-title { font-size: 32px; margin-top: 10px; }
.settings-panel Toggle { margin-top: 24px; color: #c3d4d9; }
.settings-panel Slider { margin-top: 26px; margin-bottom: 20px; color: #c3d4d9; }
.settings-panel Button { margin-top: 13px; height: 40px; }
.high-contrast .marker-name { color: #d7edf0; }
.high-contrast .muted, .high-contrast .small-copy { color: #a8c4ce; }
